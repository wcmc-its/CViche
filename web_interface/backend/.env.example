# CViche backend -- environment variable reference.
# Copy to .env for local runs. In production these are injected by the
# deployment (docker-compose.prod.yml / EKS), not committed.
#
# Never let a High-sensitivity value below (DB_USER, DB_PASSWORD,
# CVICHE_SESSION_SECRET) reach a CI log: don't `echo` or `docker compose
# config` them in a pipeline step, and mask them in the CI provider's log
# viewer if the pipeline ever needs to print an env var for debugging. See
# docs/PRODUCTION_SECRETS.md's inventory table for the full sensitivity list.

# --- LLM provider ---
# AWS Bedrock is the only supported provider (#953). Model selection lives in
# src/unified_pipeline/config/llm_config.yaml. Supply AWS credentials via the
# variables below, or an IAM role on EKS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- Database ---
# There is no SQLite fallback: app/database.py always builds a MariaDB engine
# via app/database_factory.py:create_cviche_engine, and raises if these four
# are incomplete. Point DB_HOST at a local MariaDB (e.g. the docker-compose
# `db` service) for local runs.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cviche
DB_USER=cviche_user
# DB_AUTH_MODE unset defaults to "iam" (RDS IAM auth token, no password).
# Only set DB_AUTH_MODE=password + DB_PASSWORD against a local MariaDB that
# doesn't support IAM auth -- never in a deployed environment.
# DB_AUTH_MODE=password
# DB_PASSWORD=

# --- Sessions & security ---
CVICHE_SESSION_SECRET=change-me-to-a-long-random-string
CVICHE_SECURE_COOKIES=true
CVICHE_ALLOWED_ORIGINS=https://cviche.example.org

# --- Logging ---
# CVICHE_LOG_FORMAT=text|json. Default text (compact, human-readable).
# Production prefers json so a log shipper can index by request_id.
# CVICHE_LOG_FORMAT=text
# CVICHE_LOG_LEVEL=INFO

# --- Storage backend ---
CVICHE_STORAGE_BACKEND=local
# Production (S3):
# CVICHE_STORAGE_BACKEND=s3
# CVICHE_S3_BUCKET=your-bucket-name
# CVICHE_S3_PREFIX=cviche

# --- Production-only: auth_config.yaml provisioning ---
# Path on the host to the environment-specific auth_config.yaml. compose
# bind-mounts this file read-only at /app/web_interface/backend/auth_config.yaml.
# Defaults to ./backend/auth_config.yaml (the dev location) when unset.
# CVICHE_AUTH_CONFIG_HOST_PATH=/etc/cviche/auth_config.yaml

# --- Optional ---
# NCBI_API_KEY=          # raises the PubMed enrichment rate limit
