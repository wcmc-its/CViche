# CViche backend -- environment variable reference.
# Copy to .env for local runs. In production these are injected by the
# deployment (docker-compose.prod.yml / EKS), not committed.

# --- LLM provider (pick one) ---
# OpenAI is the default provider.
OPENAI_API_KEY=sk-your-key-here
# AWS Bedrock alternative: leave OPENAI_API_KEY unset, set the provider in
# src/unified_pipeline/config/llm_config.yaml, and supply AWS credentials
# (the variables below, or an IAM role on EKS).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- Database ---
# Local dev defaults to SQLite. Production uses MySQL/MariaDB.
CVICHE_DATABASE_URL=sqlite:///./cviche_dev.db
# Production example:
# CVICHE_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/cviche

# --- Sessions & security ---
CVICHE_SESSION_SECRET=change-me-to-a-long-random-string
CVICHE_SECURE_COOKIES=true
CVICHE_ALLOWED_ORIGINS=https://cviche.example.org

# --- Storage backend ---
CVICHE_STORAGE_BACKEND=local
# Production (S3):
# CVICHE_STORAGE_BACKEND=s3
# CVICHE_S3_BUCKET=your-bucket-name
# CVICHE_S3_PREFIX=cviche

# --- Production-only: auth_config.yaml provisioning ---
# Path on the host to the environment-specific auth_config.yaml. compose
# bind-mounts this file read-only at /app/web_interface/backend/auth_config.yaml.
# Defaults to ./backend/auth_config.yaml (the dev location) when unset.
# CVICHE_AUTH_CONFIG_HOST_PATH=/etc/cviche/auth_config.yaml

# --- Optional ---
# NCBI_API_KEY=          # raises the PubMed enrichment rate limit
