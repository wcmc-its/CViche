auth:
  mode: simple  # "simple" or "saml"

saml:
  entity_id: ""                    # SP entity ID (e.g., "https://cviche.weill.cornell.edu/shibboleth")
  sp_base_url: ""                  # SP's reachable base URL (e.g., "https://cviche.weill.cornell.edu").
                                   # ACS/SLO endpoints are advertised as {sp_base_url}/api/saml/{acs,logout}.
                                   # This MUST match where the SP actually serves /api/saml/acs;
                                   # the IdP enforces it as the assertion Destination/Recipient.
                                   # Often differs from entity_id (Shibboleth convention appends /shibboleth).
  idp_metadata_url: ""             # IdP metadata URL
  discovery_url: ""                # WAYF discovery service URL
  cert_dir: "certs"                # Directory containing SP key/cert files (auto-generated if missing)

allowed_users:
  - user@example.com

admin_users:
  - admin@example.com

rate_limits:
  daily: 10
  monthly: 50

consent:
  version: "1.0"

ed:
  enabled: false  # Toggle ED group check independently of SAML mode
  access_group: ""  # DN of access group, e.g., "cn=ITS:Library:CViche/user-role,ou=application security,ou=groups,dc=weill,dc=cornell,dc=edu"
  admin_group: ""   # DN of admin group, e.g., "cn=ITS:Library:CViche/admin-role,ou=application security,ou=groups,dc=weill,dc=cornell,dc=edu"
  contact_name: ""  # Name shown in access denial message
  contact_email: "" # Email shown in access denial message

notifications:
  # Teams channel alerts on run start / terminal state. Leave empty to disable
  # (the notifier silently no-ops when unset). Must be a Teams *Workflows*
  # incoming-webhook URL — the retired Office 365 connector will not render the
  # Adaptive Cards. Config precedence: the CVICHE_TEAMS_WEBHOOK_URL *env var*
  # wins over this file. In DEPLOYED envs the URL is a bearer credential, so it
  # is delivered as a secret: buildspec.yaml writes the CVICHE_TEAMS_WEBHOOK_URL
  # CodeBuild variable into db.env -> the cviche-secrets Secret -> the pod env.
  # This file entry is mainly for local dev if you'd rather not export the env var.
  CVICHE_TEAMS_WEBHOOK_URL: ""

doctor:
  # Post-run artifact doctor: cross-stage lints over a completed run's stage
  # outputs (pure local file reads, no LLM). Runs by default after every
  # successful run and never affects run status; set to "0" to disable.
  # Config precedence: the CVICHE_RUN_DOCTOR env var wins over this file.
  # Quote the value ("0") — an unquoted YAML 0 is falsy and gets ignored by
  # the config loader, leaving the doctor enabled.
  CVICHE_RUN_DOCTOR: ""
