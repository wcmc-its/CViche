auth:
  mode: simple  # "simple" or "saml"

saml:
  entity_id: ""                    # SP entity ID (e.g., "https://cviche.med.cornell.edu/shibboleth")
  idp_metadata_url: ""             # IdP metadata URL
  discovery_url: ""                # WAYF discovery service URL
  cert_dir: "certs"                # Directory containing SP key/cert files (auto-generated if missing)

allowed_users:
  - user@example.com

admin_users:
  - admin@example.com

rate_limits:
  daily: 10
  monthly: 50

consent:
  version: "1.0"

ed:
  enabled: false  # Toggle ED group check independently of SAML mode
  access_group: ""  # DN of access group, e.g., "cn=App-CViche-Users,ou=Groups,dc=weill,dc=cornell,dc=edu"
  admin_group: ""   # DN of admin group, e.g., "cn=App-CViche-Admins,ou=Groups,dc=weill,dc=cornell,dc=edu"
  contact_name: ""  # Name shown in access denial message
  contact_email: "" # Email shown in access denial message
