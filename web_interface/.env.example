# CViche Production Environment Variables
# Copy to .env and fill in values
#
# Never let a High-sensitivity value below (DB_USER, CVICHE_SESSION_SECRET)
# reach a CI log: don't `echo` or `docker compose config`
# them in a pipeline step, and mask them in the CI provider's log viewer if
# the pipeline ever needs to print an env var for debugging. See
# docs/PRODUCTION_SECRETS.md's inventory table for the full sensitivity list.

# Database (managed MariaDB over RDS IAM auth; docker-compose.prod.yml pins
# DB_AUTH_MODE=iam, so no password goes here)
DB_HOST=mariadb-host
DB_PORT=3306
DB_NAME=cviche
DB_USER=cviche_user
MIGRATE_USER=cviche_migrate

# Session cookie signing key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
CVICHE_SESSION_SECRET=

# CORS allowed origins (comma-separated, no trailing slashes)
CVICHE_ALLOWED_ORIGINS=https://cviche.med.cornell.edu

# S3 storage
CVICHE_S3_BUCKET=wcm-cviche-storage
CVICHE_S3_PREFIX=cviche
