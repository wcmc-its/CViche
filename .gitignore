/analysis/

# Deprecated files
*_DEPRECATED*
*_backup*
# Negation: the production-backups doc is not itself a backup file
!docs/PRODUCTION_BACKUPS.md

# Pipeline runtime artifacts
src/unified_pipeline/core/*.txt
src/unified_pipeline/core/*.md

# Claude Code
.claude/

# Playwright MCP
.playwright-mcp/

# Runtime caches
src/unified_pipeline/config/institution_cache.json

# Misc
*.tar.gz
*.zip
.superpowers/

# Architecture diagrams: commit the SVGs (render on GitHub, diff as text);
# the PNGs are regenerable via scripts/diagrams/build.mjs.
docs/architecture/*.png

# Rendered secret material for k8s overlays (generated at build time by buildspec.yaml; never commit)
# The committed db.env files are intentionally empty placeholders and stay tracked;
# this only blocks future *rendered* secrets (session secret, OpenAI key, SAML SP key/cert) from being added.
k8s/overlays/*/db.env
k8s/overlays/*/auth_config.yaml
k8s/overlays/*/*.pem
k8s/overlays/*/*.key
k8s/overlays/*/*.crt
