{
  "version": "1.1",
  "created": "2025-11-29",
  "description": "Target field extraction schemas aligned with WCM CV Template (October 2022). Fields marked as 'extract: false' are not sent to LLM.",
  "template_reference": "wcm_cv_template_faculty_october_2022_final.docx",

  "extraction_philosophy": {
    "principle": "Extract only what's needed for the WCM template, except for S-codes (publications) which need full extraction for citation reconstruction and enrichment.",
    "categories": {
      "template": "Required for WCM template table columns",
      "enrichment": "Used for downstream enrichment (e.g., PMID lookup)",
      "reconstruction": "Needed to reconstruct entry in different format (e.g., Vancouver citations)",
      "optional": "Nice to have but not essential - DO NOT extract by default"
    }
  },

  "schemas": {
    "A": {
      "description": "Personal/Contact Information",
      "wcm_section": "PERSONAL DATA",
      "wcm_table": 2,
      "extraction_mode": "minimal",
      "fields": {
        "name": {"extract": true, "category": "template"},
        "email": {"extract": true, "category": "template", "wcm_column": "Email"},
        "phone": {"extract": true, "category": "template", "wcm_column": "Office telephone"},
        "address": {"extract": true, "category": "template", "wcm_column": "Office address"},
        "npi_number": {"extract": true, "category": "template", "wcm_column": "NPI number (optional)"},
        "dea_number": {"extract": true, "category": "template", "wcm_column": "DEA number (optional)"},
        "title": {"extract": false, "category": "optional", "notes": "Rarely needed separately"},
        "degrees": {"extract": false, "category": "optional", "notes": "Usually part of name"},
        "department": {"extract": false, "category": "optional"},
        "institution": {"extract": false, "category": "optional"},
        "narrative": {"extract": false, "category": "optional"}
      }
    },

    "B1": {
      "description": "Academic Degrees",
      "wcm_section": "EDUCATION - Academic Degree(s)",
      "wcm_table": 3,
      "extraction_mode": "minimal",
      "fields": {
        "degree": {"extract": true, "category": "template", "wcm_column": "Degree, include field of study"},
        "institution": {"extract": true, "category": "template", "wcm_column": "Institution, city and state"},
        "discipline": {"extract": true, "category": "template", "wcm_column": "Degree, include field of study"},
        "dates_attended": {"extract": true, "category": "template", "wcm_column": "Dates attended (mm/yyyy-mm/yyyy)"},
        "year": {"extract": true, "category": "template", "wcm_column": "Year Awarded"},
        "thesis_title": {"extract": false, "category": "optional"},
        "advisor": {"extract": false, "category": "optional"},
        "narrative": {"extract": false, "category": "optional"}
      }
    },

    "B2": {
      "description": "Other Educational Experiences",
      "wcm_section": "EDUCATION - Other Educational Experiences",
      "wcm_table": 4,
      "extraction_mode": "minimal",
      "fields": {
        "program_name": {"extract": true, "category": "template", "wcm_column": "Description"},
        "institution": {"extract": true, "category": "template", "wcm_column": "Institution, city and state"},
        "start_date": {"extract": true, "category": "template", "wcm_column": "Dates attended"},
        "end_date": {"extract": true, "category": "template", "wcm_column": "Dates attended"},
        "program_type": {"extract": false, "category": "optional"},
        "description": {"extract": false, "category": "optional"},
        "narrative": {"extract": false, "category": "optional"}
      }
    },

    "C": {
      "description": "Postdoctoral Training",
      "wcm_section": "POSTDOCTORAL TRAINING",
      "wcm_table": 5,
      "extraction_mode": "minimal",
      "fields": {
        "training_type": {"extract": true, "category": "template", "wcm_column": "Title, include area of training"},
